# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# The Firebase SDK ships as static frameworks. Without this, CocoaPods builds
# it as a static library and the Swift modules it needs are not visible, which
# surfaces as "module 'FirebaseCore' not found" the first time AppDelegate.swift
# is compiled.
$RNFirebaseAsStaticFramework = true

# react-native-firebase v26 resolves the Firebase SDK through Swift Package
# Manager by default, and SPM only ships dynamic products — incompatible with
# the static frameworks above. Opting out keeps Firebase coming from CocoaPods.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'LinguispathNative' do
  config = use_native_modules!

  # Swift pods (FirebaseCoreInternal, AppCheckCore) import these Obj-C pods,
  # which only works as static libraries if they generate module maps.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
