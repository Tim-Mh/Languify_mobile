<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PLACEHOLDER — not issued by Firebase. The Firebase project (languify-42fa2)
  has no iOS app yet, so this file borrows the real project's number, id and
  bucket and fakes the iOS GOOGLE_APP_ID and API_KEY. That is enough for
  FirebaseApp.configure() to succeed so the app can run at all; an FCM token
  fetch fails at runtime and src/lib/push.js already treats that as "this
  device cannot be pushed to", which is true.

  When the iOS app is registered in the Firebase console, download the real
  file and replace this one wholesale. Push on iOS also needs the APNs key
  uploaded to Firebase (see CLAUDE.md).
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>AIzaSyPlaceholder0000000000000000000000</string>
	<key>GCM_SENDER_ID</key>
	<string>345899284913</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>us.languify.app</string>
	<key>PROJECT_ID</key>
	<string>languify-42fa2</string>
	<key>STORAGE_BUCKET</key>
	<string>languify-42fa2.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
	<key>GOOGLE_APP_ID</key>
	<string>1:345899284913:ios:0000000000000000</string>
</dict>
</plist>
