+// The library's own `buildscript` block was removed. It pulled the Android
+// Gradle Plugin from jcenter, which Gradle 9 no longer has a method for at all
+// ("Could not find method jcenter()"), and pinned AGP 1.3.1 from 2015. The root
+// project already supplies the plugin, so the block was doing nothing but
+// breaking the build.
 
 apply plugin: 'com.android.library'
 
 android {
+    // AGP 8 requires the namespace here and no longer reads the `package`
+    // attribute out of the library manifest. Same value that manifest declared.
+    namespace 'net.no_mad.tts'
+
     compileSdkVersion safeExtGet('compileSdkVersion', 26)
     buildToolsVersion safeExtGet('buildToolsVersion', '26.0.3')
 
@@ -31,5 +31,8 @@ repositories {
 }
 
 dependencies {
-    implementation 'com.facebook.react:react-native:+'
+    // `com.facebook.react:react-native:+` is the pre-0.71 coordinate and no
+    // longer resolves. The current artifact is `react-android`, and its version
+    // is supplied by the React Native Gradle plugin, so none is named here.
+    implementation 'com.facebook.react:react-android'
 }
