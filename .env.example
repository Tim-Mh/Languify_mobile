# Copy to `.env` (gitignored) to configure a build.
#
# Read by react-native-config, which makes these available three ways from one
# file: to JS through `src/lib/env.js`, to Gradle, and to the Xcode build. That
# is why the `EXPO_PUBLIC_` prefix is gone — it only ever meant "inlined into
# the JS bundle", which is no longer the only place these go.
#
# A `.env` must exist for the Android build to succeed, even if every value in
# it is blank. Copy this file as-is to get production defaults.

# Where the backend lives. Leave blank to talk to https://api.languify.us/api,
# which is what a release build should always do.
#
# On a physical device or the Android emulator, `localhost` means the device
# itself, so src/api/client.js rewrites the host to whatever machine Metro is
# being served from. Nothing to change here for that.
API_URL=

# The web app's origin. Stripe will not redirect to a custom app scheme, so
# checkout returns here and the in-app sheet intercepts it. Leave blank for
# https://languify.us.
WEB_URL=

# Native Google sign-in. Create an OAuth client per platform in Google Cloud and
# put the *web* client ID in GOOGLE_WEB_CLIENT_ID even on a phone: that is the
# audience Google stamps into the id_token, and it is what the backend verifies
# against.
#
# Leave GOOGLE_WEB_CLIENT_ID blank and the app falls back to the browser
# redirect flow, which is what the Expo build has been using.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
