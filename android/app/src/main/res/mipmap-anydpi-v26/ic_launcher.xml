<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon, for Android 8 and up.

  Three layers, matching what app.json declared: the brand purple behind, the
  logo mark in front, and a monochrome silhouette that Android 13's themed
  icons tint to the user's wallpaper colours. Without the monochrome layer a
  themed launcher falls back to a flat grey square.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
