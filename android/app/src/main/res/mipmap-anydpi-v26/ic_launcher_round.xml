<?xml version="1.0" encoding="utf-8"?>
<!--
  The same three layers as ic_launcher. A launcher that asks for the round icon
  gets the adaptive one too and applies its own circular mask, so the artwork
  does not differ — only the resource name a given launcher looks up.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
